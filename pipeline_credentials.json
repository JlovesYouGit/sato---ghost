{
  "bitcoin": {
    "rpc": {
      "enabled": true,
      "host": "${BITCOIN_RPC_HOST:-127.0.0.1}",
      "port": "${BITCOIN_RPC_PORT:-8332}",
      "user": "${BITCOIN_RPC_USER:-}",
      "password": "${BITCOIN_RPC_PASSWORD:-}",
      "timeout_sec": 30
    },
    "api": {
      "enabled": true,
      "base_url": "${BITCOIN_API_BASE_URL:-https://blockstream.info/api}",
      "api_key": "${BITCOIN_API_KEY:-}",
      "api_key_header": "Authorization",
      "timeout_sec": 60
    }
  }
}
